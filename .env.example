# AdMob 正式廣告單元 ID
#
# 複製成 .env.production 再填。沒填的話會自動退回 Google 測試單元
# （見 src/ads/units.ts），所以少填一項不會讓 App 壞掉，只是那個版位
# 不會有收益。
#
# 注意 App ID 不在這裡：那一項要寫進 android/app/src/main/AndroidManifest.xml
# 的 com.google.android.gms.ads.APPLICATION_ID，因為 SDK 在 JS 跑起來之前
# 就要讀到它。

VITE_ADMOB_ANDROID_BANNER=
VITE_ADMOB_ANDROID_INTERSTITIAL=
VITE_ADMOB_ANDROID_REWARDED=

VITE_ADMOB_IOS_BANNER=
VITE_ADMOB_IOS_INTERSTITIAL=
VITE_ADMOB_IOS_REWARDED=

# 設成 true 可以在正式建置裡強制用測試廣告，送審或自己試玩時用，
# 免得點到自己的真廣告被判無效流量
VITE_ADMOB_FORCE_TEST=false
